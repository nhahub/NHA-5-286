{
  "version": 2,
  "_note": "Test vectors for intake (URL resolution, URL safety, model strings, model resolution, config). No secret values: credentials are environment variable NAMES only. Entries flagged legacy=true keep the old test_data/fixtures.json behaviour.",

  "requirements": [
    {
      "id": "req-001",
      "text": "Test the TodoMVC homepage: verify that the page loads, a user can add a new item, and the item counter updates correctly.",
      "url": "https://demo.playwright.dev/todomvc",
      "authorization": true,
      "expect": { "max_scenarios": 3, "english_output": true }
    },
    {
      "id": "req-002",
      "text": "اختبر أن صفحة قائمة المهام تعرض العناصر بشكل صحيح وأن مربع الإدخال يقبل النص العربي.",
      "url": "https://demo.playwright.dev/todomvc",
      "authorization": true,
      "expect": { "max_scenarios": 3, "english_output": true, "arabic_values_allowed_in_assertions": true }
    },
    {
      "id": "req-003",
      "text": "Login with valid credentials",
      "url": "https://example.com",
      "authorization": true,
      "expect": { "note": "legacy case: the site has no login form; the Planner must not invent credentials or a login flow" }
    },
    {
      "id": "req-004",
      "text": "Log in with the valid test user and verify the product list is shown.",
      "url": "https://www.saucedemo.com",
      "authorization": true,
      "expect": { "without_credentials": "BLOCKED: missing test data" }
    }
  ],

  "url_resolution": [
    { "id": "field", "field": "https://demo.playwright.dev/todomvc", "text": "Test adding an item.",
      "expect": { "status": "ok", "source": "field" } },
    { "id": "one-in-text", "field": null, "text": "On https://demo.playwright.dev/todomvc add an item.",
      "expect": { "status": "ok", "source": "requirements" } },
    { "id": "several-in-text", "field": null, "text": "Compare https://a.example.org with https://b.example.org.",
      "expect": { "status": "BLOCKED", "reason": "ambiguous target URL" } },
    { "id": "none", "field": null, "text": "Test the login page.",
      "expect": { "status": "BLOCKED", "reason": "no target URL provided" } }
  ],

  "url_safety": {
    "blocked": [
      { "id": "legacy-http-localhost", "url": "http://localhost:3000", "reason_any_of": ["scheme", "loopback"], "tier": "spec", "legacy": true },
      { "id": "legacy-http-loopback", "url": "http://127.0.0.1:8080", "reason_any_of": ["scheme", "loopback"], "tier": "spec", "legacy": true },
      { "id": "legacy-http-192", "url": "http://192.168.1.1", "reason_any_of": ["scheme", "private_range"], "tier": "spec", "legacy": true },
      { "id": "legacy-http-10", "url": "http://10.0.0.1", "reason_any_of": ["scheme", "private_range"], "tier": "spec", "legacy": true },
      { "id": "legacy-http-172", "url": "http://172.16.0.1", "reason_any_of": ["scheme", "private_range"], "tier": "spec", "legacy": true },
      { "id": "legacy-http-metadata", "url": "http://169.254.169.254", "reason_any_of": ["scheme", "link_local"], "tier": "spec", "legacy": true },

      { "id": "https-localhost", "url": "https://localhost:3000", "reason_any_of": ["loopback"], "tier": "spec" },
      { "id": "https-loopback", "url": "https://127.0.0.1:8080", "reason_any_of": ["loopback"], "tier": "spec" },
      { "id": "https-loopback-range", "url": "https://127.1.2.3", "reason_any_of": ["loopback"], "tier": "spec" },
      { "id": "https-10", "url": "https://10.0.0.1", "reason_any_of": ["private_range"], "tier": "spec" },
      { "id": "https-172-low", "url": "https://172.16.0.1", "reason_any_of": ["private_range"], "tier": "spec" },
      { "id": "https-172-high", "url": "https://172.31.255.255", "reason_any_of": ["private_range"], "tier": "spec" },
      { "id": "https-192", "url": "https://192.168.1.1", "reason_any_of": ["private_range"], "tier": "spec" },
      { "id": "https-metadata", "url": "https://169.254.169.254/latest/meta-data/", "reason_any_of": ["link_local"], "tier": "spec" },
      { "id": "http-public-site", "url": "http://demo.playwright.dev/todomvc", "reason_any_of": ["scheme"], "tier": "spec" },

      { "id": "x-unspecified", "url": "https://0.0.0.0", "reason_any_of": ["unspecified"], "tier": "extended" },
      { "id": "x-ipv6-loopback", "url": "https://[::1]", "reason_any_of": ["loopback"], "tier": "extended" },
      { "id": "x-ipv6-ula", "url": "https://[fc00::1]", "reason_any_of": ["private_range"], "tier": "extended" },
      { "id": "x-ipv6-link-local", "url": "https://[fe80::1]", "reason_any_of": ["link_local"], "tier": "extended" },
      { "id": "x-ipv4-mapped", "url": "https://[::ffff:127.0.0.1]", "reason_any_of": ["loopback", "obfuscated_ip"], "tier": "extended" },
      { "id": "x-localhost-dot", "url": "https://localhost.:3000", "reason_any_of": ["loopback"], "tier": "extended" },
      { "id": "x-localhost-case", "url": "https://LocalHost:3000", "reason_any_of": ["loopback"], "tier": "extended" },
      { "id": "x-ip-decimal", "url": "https://2130706433", "reason_any_of": ["obfuscated_ip", "loopback"], "tier": "extended" },
      { "id": "x-ip-hex", "url": "https://0x7f000001", "reason_any_of": ["obfuscated_ip", "loopback"], "tier": "extended" },
      { "id": "x-ip-octal", "url": "https://017700000001", "reason_any_of": ["obfuscated_ip", "loopback"], "tier": "extended" },
      { "id": "x-userinfo-loopback", "url": "https://user@127.0.0.1", "reason_any_of": ["userinfo", "loopback"], "tier": "extended" },
      { "id": "x-userinfo-trick", "url": "https://demo.playwright.dev@127.0.0.1/", "reason_any_of": ["userinfo", "loopback"], "tier": "extended" },
      { "id": "x-file-scheme", "url": "file:///etc/passwd", "reason_any_of": ["scheme"], "tier": "extended" },
      { "id": "x-ftp-scheme", "url": "ftp://example.org", "reason_any_of": ["scheme"], "tier": "extended" },
      { "id": "x-javascript-scheme", "url": "javascript:alert(1)", "reason_any_of": ["scheme", "malformed"], "tier": "extended" },
      { "id": "x-empty", "url": "", "reason_any_of": ["malformed"], "tier": "extended" },
      { "id": "x-not-a-url", "url": "not a url", "reason_any_of": ["malformed", "scheme"], "tier": "extended" }
    ],
    "allowed": [
      { "id": "ok-todomvc", "url": "https://demo.playwright.dev/todomvc" },
      { "id": "ok-saucedemo", "url": "https://www.saucedemo.com" },
      { "id": "ok-port-path-query", "url": "https://example.org:8443/path?q=1" },
      { "id": "ok-uppercase-scheme", "url": "HTTPS://Demo.Playwright.dev/todomvc" },
      { "id": "ok-172-below-range", "url": "https://172.15.255.255", "note": "boundary: just below 172.16.0.0/12" },
      { "id": "ok-172-above-range", "url": "https://172.32.0.1", "note": "boundary: just above 172.16.0.0/12" },
      { "id": "ok-192-169", "url": "https://192.169.0.1", "note": "boundary: next to 192.168.0.0/16" },
      { "id": "ok-11", "url": "https://11.0.0.1", "note": "boundary: next to 10.0.0.0/8" },
      { "id": "ok-169-253", "url": "https://169.253.0.1", "note": "boundary: next to 169.254.0.0/16" }
    ],
    "http_opt_in": [
      { "id": "http-default-blocked", "url": "http://demo.example.org", "allow_http": false, "expect": "blocked" },
      { "id": "http-enabled-allowed", "url": "http://demo.example.org", "allow_http": true, "expect": "allowed" },
      { "id": "http-enabled-private-still-blocked", "url": "http://10.0.0.1", "allow_http": true, "expect": "blocked" },
      { "id": "http-enabled-localhost-still-blocked", "url": "http://localhost:3000", "allow_http": true, "expect": "blocked" }
    ],
    "redirect_cases": [
      { "id": "redirect-to-loopback", "start": "https://demo.example.org/go", "redirects_to": "https://127.0.0.1/admin",
        "expect": "blocked", "needs_mock": true, "note": "spec: re-check after redirects" },
      { "id": "redirect-to-metadata", "start": "https://demo.example.org/go", "redirects_to": "https://169.254.169.254/latest/meta-data/",
        "expect": "blocked", "needs_mock": true },
      { "id": "redirect-to-http", "start": "https://demo.example.org/go", "redirects_to": "http://demo.example.org/plain",
        "expect": "blocked", "needs_mock": true, "note": "HTTPS-only applies to redirect targets" }
    ],
    "dns_cases": [
      { "id": "host-resolves-to-private", "host": "internal.example.org", "resolves_to": "10.0.0.5",
        "expect": "blocked", "needs_mock": true, "note": "open design question for intake/safety.py: resolve and re-check IPs" },
      { "id": "host-resolves-to-loopback", "host": "rebind.example.org", "resolves_to": "127.0.0.1",
        "expect": "blocked", "needs_mock": true }
    ]
  },

  "authorization": {
    "cases": [
      { "id": "missing", "authorization": false, "expect": { "proceeds": false, "network_calls": 0 } },
      { "id": "granted", "authorization": true, "expect": { "proceeds": true } }
    ]
  },

  "models": {
    "valid": ["openai:gpt-4o", "openai:gpt-4o-mini", "anthropic:claude-sonnet-4-6"],
    "malformed": ["gpt-4o", "", "openai/", "openai:", ":gpt-4o"],
    "local_not_allowed": ["ollama:llama3", "vllm:mistral"],
    "unsupported_provider": ["local:llama3"],
    "legacy_invalid": ["gpt-4o", "local:llama3", "", "openai/"],
    "_note": "unsupported_provider has a valid provider:model format and fails later at model initialisation, not at the format check."
  },

  "model_resolution": [
    { "id": "override-wins",
      "request": { "planner_model": null, "codegen_model": "anthropic:claude-sonnet-4-6", "healer_model": null },
      "default_model": "openai:gpt-4o", "fallback_model": null,
      "env_keys_present": ["OPENAI_API_KEY", "ANTHROPIC_API_KEY"],
      "expect": { "planner": "openai:gpt-4o", "codegen": "anthropic:claude-sonnet-4-6", "healer": "openai:gpt-4o" } },
    { "id": "all-defaults",
      "request": { "planner_model": null, "codegen_model": null, "healer_model": null },
      "default_model": "openai:gpt-4o", "fallback_model": null,
      "env_keys_present": ["OPENAI_API_KEY"],
      "expect": { "planner": "openai:gpt-4o", "codegen": "openai:gpt-4o", "healer": "openai:gpt-4o" } },
    { "id": "nothing-configured",
      "request": { "planner_model": null, "codegen_model": null, "healer_model": null },
      "default_model": null, "fallback_model": null,
      "env_keys_present": [],
      "expect": { "status": "ERROR", "reason": "no usable model" } },
    { "id": "missing-api-key",
      "request": { "planner_model": null, "codegen_model": null, "healer_model": null },
      "default_model": "openai:gpt-4o", "fallback_model": null,
      "env_keys_present": [],
      "expect": { "status": "ERROR", "reason": "missing API key" } }
  ],

  "config": {
    "scenario_cap": { "default": 3, "minimum": 1, "maximum": 5, "valid": [1, 3, 5], "invalid": [0, 6, -1] },
    "fixed_mvp": { "browser": "chromium", "headless": true, "timeout_ms": 30000 }
  },

  "secrets_policy": {
    "credential_env_vars": ["TEST_USERNAME", "TEST_PASSWORD", "TEST_LOCKED_USERNAME", "TEST_LOCKED_PASSWORD"],
    "rule": "No literal passwords, tokens or API keys in any committed JSON; reference environment variable names only."
  }
}