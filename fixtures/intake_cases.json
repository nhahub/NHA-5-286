{
  "version": 3,
  "_note": "Test vectors for intake only (URL resolution, URL safety, authorization, model strings, model resolution, config). End-to-end requirements live in test_data/fixtures.json. No secrets: only environment variable NAMES appear anywhere. tier=spec means required by the architecture spec; tier=extended is hardening. needs_mock=true means the case needs a mocked network/DNS. open_question=true means the spec does not decide the behaviour yet: agree with P1 before asserting it.",
  "reason_codes": [
    "scheme",
    "loopback",
    "private_range",
    "link_local",
    "unspecified",
    "obfuscated_ip",
    "userinfo",
    "malformed"
  ],
  "url_resolution": [
    {
      "id": "field",
      "field": "https://demo.playwright.dev/todomvc",
      "text": "Test adding an item.",
      "expect": {
        "status": "ok",
        "source": "field"
      }
    },
    {
      "id": "field-wins-over-text",
      "field": "https://demo.playwright.dev/todomvc",
      "text": "Also see https://other.example.org for context.",
      "expect": {
        "status": "ok",
        "source": "field",
        "url": "https://demo.playwright.dev/todomvc"
      }
    },
    {
      "id": "one-in-text",
      "field": null,
      "text": "On https://demo.playwright.dev/todomvc add an item.",
      "expect": {
        "status": "ok",
        "source": "requirements"
      }
    },
    {
      "id": "empty-string-field",
      "field": "",
      "text": "On https://demo.playwright.dev/todomvc add an item.",
      "expect": {
        "status": "ok",
        "source": "requirements"
      }
    },
    {
      "id": "whitespace-field",
      "field": "   ",
      "text": "On https://demo.playwright.dev/todomvc add an item.",
      "expect": {
        "status": "ok",
        "source": "requirements"
      }
    },
    {
      "id": "trailing-punctuation",
      "field": null,
      "text": "Open https://demo.playwright.dev/todomvc.",
      "expect": {
        "status": "ok",
        "source": "requirements",
        "url": "https://demo.playwright.dev/todomvc"
      }
    },
    {
      "id": "arabic-text-with-url",
      "field": null,
      "text": "اختبر https://demo.playwright.dev/todomvc وأضف عنصرا جديدا.",
      "expect": {
        "status": "ok",
        "source": "requirements",
        "url": "https://demo.playwright.dev/todomvc"
      }
    },
    {
      "id": "several-in-text",
      "field": null,
      "text": "Compare https://a.example.org with https://b.example.org.",
      "expect": {
        "status": "BLOCKED",
        "reason": "ambiguous target URL"
      }
    },
    {
      "id": "same-url-twice-in-text",
      "field": null,
      "text": "Open https://a.example.org then reload https://a.example.org.",
      "note": "the same URL repeated counts once: extract_urls_from_text returns a deduplicated list",
      "expect": {
        "status": "ok",
        "source": "requirements"
      }
    },
    {
      "id": "none",
      "field": null,
      "text": "Test the login page.",
      "expect": {
        "status": "BLOCKED",
        "reason": "no target URL provided"
      }
    },
    {
      "id": "unsafe-field-never-falls-back",
      "field": "https://localhost:3000",
      "text": "Also https://demo.playwright.dev/todomvc",
      "expect": {
        "status": "BLOCKED",
        "reason": "unsafe URL",
        "note": "the target is never guessed or substituted from the text"
      }
    },
    {
      "id": "unsafe-url-in-text",
      "field": null,
      "text": "Test http://localhost:3000 please.",
      "expect": {
        "status": "BLOCKED",
        "reason": "unsafe URL"
      }
    }
  ],
