  "authorization": {
    "cases": [
      {
        "id": "missing",
        "authorization": false,
        "expect": {
          "proceeds": false,
          "network_calls": 0
        }
      },
      {
        "id": "granted",
        "authorization": true,
        "expect": {
          "proceeds": true
        }
      }
    ]
  },
  "models": {
    "valid": [
      "openai:gpt-4o",
      "openai:gpt-4o-mini",
      "anthropic:claude-sonnet-4-6"
    ],
    "malformed": [
      "gpt-4o",
      "",
      "openai/",
      "openai:",
      ":gpt-4o"
    ],
    "local_not_allowed": [
      "ollama:llama3",
      "vllm:mistral"
    ],
    "unsupported_provider": [
      "local:llama3"
    ],
    "_note": "unsupported_provider has a valid provider:model format and fails later at model initialisation, not at the format check.",
    "legacy_invalid": [
      "gpt-4o",
      "local:llama3",
      "",
      "openai/"
    ]
  },
  "model_resolution": [
    {
      "id": "override-wins",
      "request": {
        "planner_model": null,
        "codegen_model": "anthropic:claude-sonnet-4-6",
        "healer_model": null
      },
      "default_model": "openai:gpt-4o",
      "fallback_model": null,
      "env_keys_present": [
        "OPENAI_API_KEY",
        "ANTHROPIC_API_KEY"
      ],
      "expect": {
        "planner": "openai:gpt-4o",
        "codegen": "anthropic:claude-sonnet-4-6",
        "analyzer": "openai:gpt-4o",
        "fix_proposal": "openai:gpt-4o"
      }
    },
    {
