  "config": {
    "scenario_cap": {
      "default": 3,
      "minimum": 1,
      "maximum": 5,
      "valid": [
        1,
        3,
        5
      ],
      "invalid": [
        0,
        6,
        -1
      ]
    },
    "fixed_mvp": {
      "browser": "chromium",
      "headless": true,
      "timeout_ms": 30000
    }
  },
  "secrets_policy": {
    "credential_env_vars": [
      "TEST_USERNAME",
      "TEST_PASSWORD",
      "TEST_LOCKED_USERNAME",
      "TEST_LOCKED_PASSWORD"
    ],
    "rule": "No literal passwords, tokens or API keys in any committed JSON; reference environment variable names only."
  },
  "requirements": [
    {
      "id": "req-001",
      "text": "Test the TodoMVC homepage: verify that the page loads, a user can add a new item, and the item counter updates correctly.",
      "url": "https://demo.playwright.dev/todomvc",
      "authorization": true,
      "expect": {
        "max_scenarios": 3,
        "english_output": true
      }
    },
    {
      "id": "req-002",
      "text": "اختبر أن صفحة قائمة المهام تعرض العناصر بشكل صحيح وأن مربع الإدخال يقبل النص العربي.",
      "url": "https://demo.playwright.dev/todomvc",
      "authorization": true,
      "expect": {
        "max_scenarios": 3,
        "english_output": true,
        "arabic_values_allowed_in_assertions": true
      }
    },
    {
      "id": "req-003",
      "text": "Login with valid credentials",
      "url": "https://example.com",
      "authorization": true,
      "expect": {
        "note": "legacy case: the site has no login form; the Planner must not invent credentials or a login flow"
      }
    },
    {
      "id": "req-004",
