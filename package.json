{
  "private": "true",
  "name": "ai-test-automation",
  "version": "0.1.0",
  "description": "TypeScript test runner for AI-generated Playwright specs",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report runs/_local/html-report",
    "install:browsers": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test:list": "playwright test --list"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0"
  }
}
