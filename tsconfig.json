{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": { "@support/*": ["./support/*"],
               "@data/*": ["./test_data/*"]
   }
  },
  "include": ["support", "reference", "runs/**/tests", "playwright.config.ts"]
}