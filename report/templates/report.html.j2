<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Test Run Report {{ r.run_id }}</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: #1c1c1e; margin: 2rem auto; max-width: 960px; padding: 0 1rem; line-height: 1.5; }
  h1 { margin-bottom: .25rem; }
  h2 { margin-top: 2rem; border-bottom: 1px solid #d0d0d5; padding-bottom: .25rem; }
  h3 { margin-bottom: .25rem; }
  table { border-collapse: collapse; width: 100%; margin: .75rem 0; }
  th, td { border: 1px solid #d0d0d5; padding: .4rem .6rem; text-align: left; vertical-align: top; }
  th { background: #f2f2f7; }
  pre { background: #f6f8fa; border: 1px solid #d0d0d5; border-radius: 6px; padding: .75rem; overflow-x: auto; white-space: pre-wrap; word-break: break-word; }
  .badge { display: inline-block; padding: .15rem .6rem; border-radius: 999px; font-weight: 700; color: #fff; }
  .s-pass, .s-passed { background: #1a7f37; }
  .s-fail, .s-failed { background: #cf222e; }
  .s-blocked { background: #9a6700; }
  .s-error, .s-not_run { background: #6e40c9; }
  .note { color: #57606a; font-style: italic; }
  .diff-del { color: #cf222e; } .diff-add { color: #1a7f37; }
  @media print { body { margin: 0; max-width: none; } }
</style>
</head>
<body>
<h1>Test Run Report</h1>
<p><span class="badge s-{{ (r.terminal_status or 'ERROR')|lower }}">{{ r.terminal_status or "ERROR" }}</span></p>

<table>
  <tr><th>Run ID</th><td>{{ r.run_id or "unknown" }}</td></tr>
  <tr><th>Target URL</th><td>{{ r.target_url.url or "none" }}{% if r.target_url.source %} (from {{ r.target_url.source }}){% endif %}</td></tr>
  <tr><th>Duration</th><td>{% if r.duration_s is number %}{{ "%.1f"|format(r.duration_s) }} s{% else %}n/a{% endif %}</td></tr>
  <tr><th>Regenerations</th><td>{{ r.attempts.generation_retries if r.attempts.generation_retries is number else "n/a" }}</td></tr>
  <tr><th>Healing attempts</th><td>{% if r.attempts.healing %}{% for sid, n in r.attempts.healing.items() %}{{ sid }}: {{ n }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}none{% endif %}</td></tr>
</table>

<h2>Requirements</h2>
<pre dir="auto">{{ r.requirements_text or "(not provided)" }}</pre>
{% if r.requirements_note %}
<p class="note">{{ r.requirements_note }}</p>
{% endif %}

<h2>Summary</h2>
<table>
  <tr><th>Total</th><th>Passed</th><th>Failed</th><th>Blocked</th></tr>
  <tr><td>{{ r.counts.total or 0 }}</td><td>{{ r.counts.passed or 0 }}</td><td>{{ r.counts.failed or 0 }}</td><td>{{ r.counts.blocked or 0 }}</td></tr>
</table>

<h2>Models used</h2>
{% if r.models_used %}
<table>
  <tr><th>Agent</th><th>Model</th></tr>
{% for agent, model in r.models_used.items() %}
  <tr><td>{{ agent }}</td><td>{{ model }}</td></tr>
{% endfor %}
</table>
{% else %}
<p>No model was used in this run.</p>
{% endif %}

<h2>Scenarios</h2>
{% if r.scenarios %}
<table>
  <tr><th>ID</th><th>Scenario</th><th>Status</th><th>Duration</th><th>Notes</th></tr>
{% for s in r.scenarios %}
  <tr>
    <td>{{ s.id }}</td><td>{{ s.name }}</td>
    <td><span class="badge s-{{ (s.status or 'not_run')|lower }}">{{ s.status }}</span></td>
    <td>{% if s.duration_s is number %}{{ "%.1f"|format(s.duration_s) }} s{% else %}n/a{% endif %}</td>
    <td>{{ s.blocked_reason or "" }}</td>
  </tr>
{% endfor %}
</table>
{% for s in r.scenarios %}
<h3>{{ s.id }}: {{ s.name }}</h3>
<ol>
{% for step in s.steps or [] %}
  <li><code>{{ step.action }}</code>{% if step.target %} {{ step.target }}{% endif %}{% if step.value %} = <span dir="auto">{{ step.value }}</span>{% endif %}</li>
{% endfor %}
</ol>
<p><strong>Expected result:</strong> {{ s.expected_result or "n/a" }}</p>
{% endfor %}
{% else %}
<p>No scenarios were produced.</p>
{% endif %}
{% if r.failure_analysis %}

<h2>Failure analysis</h2>
{% for f in r.failure_analysis %}
<h3>{{ f.scenario_id }}: {{ f.failure_type }}{% if f.subtype %} / {{ f.subtype }}{% endif %}</h3>
<ul>
  <li><strong>Confidence:</strong> {{ f.confidence or "n/a" }}</li>
  <li><strong>Application bug:</strong> {{ "yes" if f.application_bug else "no" }}</li>
  <li><strong>Fix required:</strong> {{ "yes" if f.fix_required else "no" }}</li>
  <li><strong>Root cause:</strong> {{ f.root_cause }}</li>
  <li><strong>Evidence:</strong> {{ f.evidence }}</li>
</ul>
{% if f.explanation %}
<p>{{ f.explanation }}</p>
{% endif %}
{% endfor %}
{% endif %}
{% if r.evidence %}

<h2>Evidence</h2>
{% for e in r.evidence %}
<h3>{{ e.scenario_id }}</h3>
<ul>
  <li><strong>Final URL:</strong> {{ e.final_url or "n/a" }}</li>
  <li><strong>Screenshot:</strong> {{ e.screenshot or "n/a" }}</li>
  <li><strong>Trace:</strong> {{ e.trace or "n/a" }}</li>
{% if e.console_errors %}
  <li><strong>Console errors:</strong>
    <ul>
{% for c in e.console_errors %}
      <li><code>{{ c.type }}</code> {{ c.text }}</li>
{% endfor %}
    </ul>
  </li>
{% endif %}
{% if e.failed_requests %}
  <li><strong>Failed requests:</strong>
    <ul>
{% for n in e.failed_requests %}
      <li>{{ n.method }} {{ n.url }} &rarr; {{ n.status if n.status is number else n.failure }}</li>
{% endfor %}
    </ul>
  </li>
{% endif %}
</ul>
{% endfor %}
{% endif %}
{% if r.patches %}

<h2>Patches</h2>
{% for p in r.patches %}
<h3>{{ p.scenario_id }}: {{ "APPLIED" if p.applied else "NOT APPLIED" }}{% if p.risky %} (risky){% endif %}</h3>
<ul>
  <li><strong>Reason:</strong> {{ p.reason }}</li>
  <li><strong>Approval:</strong> {{ p.approval or "n/a" }}</li>
{% if p.requirement %}
  <li><strong>Original requirement:</strong> <span dir="auto">{{ p.requirement }}</span></li>
{% endif %}
</ul>
<pre>{{ p.diff }}</pre>
{% endfor %}
{% endif %}
{% if r.generated_code %}

<h2>Generated code</h2>
{% for g in r.generated_code %}
<h3>{{ g.file }}{% if g.patched %} (patched){% endif %}</h3>
<pre>{{ g.code }}</pre>
{% endfor %}
{% endif %}
{% if r.defect_candidates %}

<h2>Defect candidates</h2>
<p class="note">Application failures only. Nothing is filed automatically; an issue tracker integration is a future phase.</p>
<ul>
{% for d in r.defect_candidates %}
  <li><strong>{{ d.scenario_id }}:</strong> {{ d.summary }}</li>
{% endfor %}
</ul>
{% endif %}
{% if r.errors %}

<h2>System errors</h2>
<ul>
{% for e in r.errors %}
  <li>{{ e }}</li>
{% endfor %}
</ul>
{% endif %}
</body>
</html>
