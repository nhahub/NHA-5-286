# ── LLM Configuration (provider:model format, e.g. openai:gpt-4o) ────────────
# All model fields are optional; if empty the global DEFAULT_MODEL is used.
DEFAULT_MODEL=openai:gpt-4o
FALLBACK_MODEL=openai:gpt-4o-mini

# ── API Keys (never commit real keys; live in environment only) ───────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Run behaviour ─────────────────────────────────────────────────────────────
# Token budget per run (spec §6)
MAX_TOKENS_PER_RUN=100000

# Healing mode: "auto" applies selector/timing fixes automatically;
# assertion-change fixes always require human approval regardless of this setting.
AUTO_HEAL_MODE=auto

# Human Code Review mode: "on" pauses after 2 failed generation attempts;
# "off" sets BLOCKED immediately (suitable for CI runs).
HUMAN_REVIEW_MODE=off

# Default number of scenarios per run (1–5; Advanced UI setting raises cap to 5)
SCENARIO_CAP=3

# Allow plain HTTP targets (false by default — HTTPS only per spec §7)
ALLOW_HTTP=false

# ── UI ────────────────────────────────────────────────────────────────────────
GRADIO_SERVER_PORT=7860
